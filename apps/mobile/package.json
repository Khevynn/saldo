{
  "name": "@finance/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "start": "expo start --dev-client",
    "start:tunnel": "expo start --dev-client --tunnel",
    "android": "expo run:android",
    "native:prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "dev:eas": "npx eas-cli@latest build --platform android --profile development",
    "apk:local": "expo prebuild --platform android && cd android && gradlew.bat assembleRelease",
    "apk:eas": "npx eas-cli@latest build --platform android --profile preview",
    "aab:eas": "npx eas-cli@latest build --platform android --profile production",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview --platform android --auto",
    "update:production": "npx eas-cli@latest update --channel production --environment production --platform android --auto"
  },
  "dependencies": {
    "@clerk/expo": "^4.7.1",
    "@clerk/expo-google-signin": "^1.0.4",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "lucide-react-native": "^1.48.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@expo/config-plugins": "~57.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
