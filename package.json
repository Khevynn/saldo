{
  "name": "controle-monetario",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "setup:local": "tsx scripts/dev-database.ts --setup",
    "dev:db": "tsx scripts/dev-database.ts",
    "dev:local": "concurrently -k -n db,app -c yellow,green \"npm run dev:db\" \"tsx scripts/wait-database.ts && npm run dev\"",
    "docker:up": "docker compose up --build -d",
    "docker:logs": "docker compose logs -f api web db",
    "docker:down": "docker compose down",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.scripts.json",
    "test": "vitest run --configLoader runner",
    "test:postgres": "npm run build -w apps/api && node --experimental-strip-types scripts/test-postgres.ts",
    "preview:ui": "vite --config apps/web/tests/preview.config.ts --configLoader runner",
    "format": "prettier --write apps scripts docs README.md package.json tsconfig.json vitest.config.ts",
    "db:migrate": "tsx --env-file=.env apps/api/src/database/migrate.ts",
    "db:backup": "node --experimental-strip-types --env-file=.env scripts/backup-database.ts",
    "db:provision": "tsx --env-file=.env apps/api/src/database/provision.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@nestjs/testing": "^12.0.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.2.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "supertest": "^7.3.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
