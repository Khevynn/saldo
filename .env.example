# Copy to .env. Use distinct credentials for migrations and the API.
NODE_ENV=development
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/finance
DATABASE_URL=postgresql://finance_app:change-local-password@localhost:5432/finance
APP_DB_PASSWORD=change-local-password
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
CLERK_STATUS_CACHE_SECONDS=60
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=
RATE_LIMIT_PER_MINUTE=180
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
DB_TRANSACTION_TIMEOUT_MS=20000
DB_MAX_CONNECTION_LIFETIME_SECONDS=300
IDEMPOTENCY_RETENTION_DAYS=90
VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_URL=/api

# Optional overrides for the isolated Docker test environment.
DOCKER_POSTGRES_PASSWORD=docker-postgres-local-only
DOCKER_APP_DB_PASSWORD=docker-finance-app-local-only
DOCKER_DB_PORT=55433
DOCKER_WEB_PORT=8080

# Public access through a remotely managed Cloudflare Tunnel.
PUBLIC_APP_URL=https://saldo.example.com
CLOUDFLARE_TUNNEL_TOKEN=
ALLOW_PLAINTEXT_DATABASE_ON_PRIVATE_DOCKER_NETWORK=false
